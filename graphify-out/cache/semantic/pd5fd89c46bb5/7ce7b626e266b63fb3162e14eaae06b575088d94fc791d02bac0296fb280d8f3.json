{"nodes": [{"id": "styling_guidelines_styling_guidelines", "label": "Styling Guidelines (living document)", "file_type": "document", "source_file": "STYLING_GUIDELINES.md", "source_location": "L1-6", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "styling_guidelines_summary_stat_cards", "label": "Summary stat cards convention", "file_type": "concept", "source_file": "STYLING_GUIDELINES.md", "source_location": "L7-16", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Center-aligned rounded tinted cards (rounded-2xl border px-5 py-4) with uppercase label, large bold coloured value, optional muted sub-line, applied consistently across all tabs."}, {"id": "styling_guidelines_tables", "label": "Tables convention", "file_type": "concept", "source_file": "STYLING_GUIDELINES.md", "source_location": "L18-30", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Edge padding px-6 to align with card title, center-aligned columns except lengthy label columns which stay left-aligned, whole-pound values with a shown GBP sign, reusing shared inline editors."}, {"id": "styling_guidelines_budget_history_mirror", "label": "Budget table \u21c4 History table mirror", "file_type": "rationale", "source_file": "STYLING_GUIDELINES.md", "source_location": "L28-30", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The Dashboard/Budget breakdown table and the History category-breakdown table must stay visually identical on desktop and mobile; any change to one is applied to the other."}, {"id": "styling_guidelines_charts", "label": "Charts convention", "file_type": "concept", "source_file": "STYLING_GUIDELINES.md", "source_location": "L32-39", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Every line chart gets a gradient shade; year-to-date is solid+shaded and the projected future is dashed+unshaded; recharts wrapped in ResponsiveContainer width=100%. Tooltips disabled on mobile because on touch they stick open while scrolling and the tables below carry the numbers."}, {"id": "styling_guidelines_cumulativespendchart", "label": "CumulativeSpendChart component", "file_type": "code", "source_file": "STYLING_GUIDELINES.md", "source_location": "L34-35", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "styling_guidelines_shared_building_blocks", "label": "Shared building blocks (common.tsx, MoneyInput, Tooltip)", "file_type": "concept", "source_file": "STYLING_GUIDELINES.md", "source_location": "L41-47", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "styling_guidelines_mobile_responsive", "label": "Mobile / responsive conventions", "file_type": "concept", "source_file": "STYLING_GUIDELINES.md", "source_location": "L49-97", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Desktop-first with mobile overrides below the md breakpoint (768px); all mobile changes must leave the desktop layout unchanged."}, {"id": "styling_guidelines_stacked_cards", "label": "Data tables \u2192 stacked cards on mobile", "file_type": "rationale", "source_file": "STYLING_GUIDELINES.md", "source_location": "L64-71", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Preferred over horizontal scrolling for any table with more than 3 meaningful columns: hide the table with md:block and add a md:hidden card list of label + primary right-aligned stat block plus a 2-column grid of fields."}, {"id": "styling_guidelines_useismobile", "label": "hooks/useIsMobile.ts (<768px matcher)", "file_type": "code", "source_file": "STYLING_GUIDELINES.md", "source_location": "L47", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "styling_guidelines_lib_chart", "label": "lib/chart.ts (axis/tooltip styling
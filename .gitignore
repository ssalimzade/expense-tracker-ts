# Dependencies / build
node_modules/
dist/

# Incremental-build caches — churn on every `tsc -b`, never worth committing
*.tsbuildinfo

# Wrangler / Cloudflare local state
.wrangler/

# Local tooling state — leaks absolute home paths, and is machine-specific
.claude/

# Local secrets — never commit (holds DATABASE_URL for local dev)
.dev.vars
*.env
.env

# OS / editor
.DS_Store
*.log
